<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUS LOCKDOWN"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="32dp" />

        <!-- Neo-brutalist Card Wrapper for Timer (Dark) -->
        <LinearLayout
            android:id="@+id/overlay_card"
            android:layout_width="240dp"
            android:layout_height="200dp"
            android:background="@drawable/brutalist_card_dark"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="40dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/overlay_timer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25:00"
                android:textColor="#FFFFFF"
                android:textSize="56sp"
                android:textStyle="bold" />
            
            <TextView
                android:id="@+id/overlay_minutes_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINUTES REMAINING"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR DEVICE IS LOCKED"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/overlay_blocked_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internet &amp; apps are blocked.\nVoice calls are allowed."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/overlay_btn_dialer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN DIALER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#333333"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</RelativeLayout>
